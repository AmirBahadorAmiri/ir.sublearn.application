<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SubLearn" parent="Theme.Material3.Dark.NoActionBar">

        <item name="android:windowDisablePreview">true</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">@color/semiBackground</item>
        <item name="colorPrimaryDark">#FF6200EE</item>
        <item name="colorPrimary">#FF6200EE</item>
        <item name="android:colorPrimary">#FF6200EE</item>
        <item name="colorSurface">#FF6200EE</item>
        <item name="android:statusBarColor">#FF6200EE</item>
        <item name="android:colorPrimaryDark">#FF6200EE</item>
        <item name="android:windowLightStatusBar">false</item>

    </style>

    <style name="TextLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:textColorHint">@color/hintColor</item>
    </style>

    <style name="TextMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:textColorHint">@color/hintColor</item>
    </style>

    <style name="TextSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:textColorHint">@color/hintColor</item>
    </style>

</resources>