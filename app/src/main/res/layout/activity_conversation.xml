<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pageBackground">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/activity_conversation_back_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/back_icon" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/activity_conversation_settings_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintLeft_toRightOf="@id/activity_conversation_back_btn"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/setting_icon_bg" />

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:text="@string/conversation"
        android:textColor="@color/textColor"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/activity_conversation_back_btn"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/activity_conversation_back_btn" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/activity_conversation_mic_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/activity_conversation_back_btn"
        app:srcCompat="@drawable/mic_icon_nobg" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/activity_conversation_reverse_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="@id/activity_conversation_mic_btn"
        app:layout_constraintLeft_toLeftOf="@id/activity_conversation_mic_btn"
        app:layout_constraintLeft_toRightOf="@id/activity_conversation_mic_btn"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/activity_conversation_mic_btn"
        app:srcCompat="@drawable/reverse_icon_nobg" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/activity_conversation_from_btn"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="4dp"
        android:textColor="@color/textColor"
        android:textSize="16sp"
        app:backgroundTint="@color/semiBackground"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="@id/activity_conversation_mic_btn"
        app:layout_constraintLeft_toRightOf="@id/activity_conversation_mic_btn"
        app:layout_constraintRight_toLeftOf="@id/activity_conversation_reverse_btn"
        app:layout_constraintTop_toTopOf="@id/activity_conversation_mic_btn"
        app:rippleColor="@color/pageBackground"
        tools:text="فارسی" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/activity_conversation_to_btn"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="8dp"
        android:textColor="@color/textColor"
        android:textSize="16sp"
        app:backgroundTint="@color/semiBackground"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="@id/activity_conversation_mic_btn"
        app:layout_constraintLeft_toRightOf="@id/activity_conversation_reverse_btn"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/activity_conversation_mic_btn"
        app:rippleColor="@color/pageBackground"
        tools:text="انگلیسی" />

    <View
        android:id="@+id/activity_conversation_edit_view"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:background="@drawable/round_background_16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/activity_conversation_from_btn" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/activity_conversation_send_from"
        android:layout_width="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:background="@drawable/ripple_color"
        app:layout_constraintBottom_toBottomOf="@id/activity_conversation_edit_view"
        app:layout_constraintLeft_toLeftOf="@id/activity_conversation_edit_view"
        app:layout_constraintTop_toTopOf="@id/activity_conversation_edit_view"
        app:srcCompat="@drawable/caret_left" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/activity_conversation_send_to"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/ripple_color"
        app:layout_constraintBottom_toBottomOf="@id/activity_conversation_edit_view"
        app:layout_constraintRight_toRightOf="@id/activity_conversation_edit_view"
        app:layout_constraintTop_toTopOf="@id/activity_conversation_edit_view"
        app:srcCompat="@drawable/caret_right" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/activity_conversation_edittext"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:hint="@string/insert_your_text"
        android:textColor="@color/textColor"
        android:textColorHint="@color/hintColor"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginRight="4dp"
        android:layout_marginLeft="4dp"
        app:layout_constraintBottom_toBottomOf="@id/activity_conversation_edit_view"
        app:layout_constraintLeft_toRightOf="@id/activity_conversation_send_from"
        app:layout_constraintRight_toLeftOf="@id/activity_conversation_send_to"
        app:layout_constraintTop_toTopOf="@id/activity_conversation_edit_view" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/activity_conversation_recyclerview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/activity_conversation_edit_view" />

</androidx.constraintlayout.widget.ConstraintLayout>